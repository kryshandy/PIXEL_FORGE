# =============================================================================
# PIXEL FORGE AI HACKATHON — Copilote IA Oil & Gas
# Modèle de variables d'environnement. Copier ce fichier en `.env` et remplir.
# Ne JAMAIS versionner le fichier .env (voir .gitignore).
# =============================================================================

# --- Application ---
APP_NAME=Pixel Forge Copilote IA
VERSION=0.1.0
ENVIRONMENT=development

# --- Serveur API local ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# --- CORS : origines autorisées du frontend (séparées par des virgules) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Base vectorielle Chroma (Flo - Jour 1) ---
CHROMA_PERSIST_DIR=.chroma
CHROMA_COLLECTION_NAME=petrosage_corpus
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
# Désactive la télémétrie chromadb (évite un warning de compat posthog inoffensif mais bruyant)
ANONYMIZED_TELEMETRY=False

# --- LLM (intégration par Flo - Jour 3) ---
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-5
